{
  "WHEN rule": {
    "prefix": "when",
    "body": [
      "WHEN ${1:.path} =~ /${2:pattern}/",
      "$0"
    ],
    "description": "Match a branch path against a regex"
  },
  "SET assignment": {
    "prefix": "set",
    "body": [
      "SET ${1:.path} = ${2:value}",
      "$0"
    ],
    "description": "Set a branch path in the envelope"
  },
  "EXEC op": {
    "prefix": "exec",
    "body": [
      "EXEC \"op://${1:NAME}\"",
      "$0"
    ],
    "description": "Forward the envelope to a named operation"
  },
  "EMIT event": {
    "prefix": "emit",
    "body": [
      "EMIT \"${1:topic}\" ${2:.payload}",
      "$0"
    ],
    "description": "Emit an event"
  },
  "Full rule (WHEN/SET/EXEC)": {
    "prefix": "rule",
    "body": [
      "WHEN ${1:.path} =~ /${2:pattern}/",
      "SET ${3:.field} = ${4:\"value\"}",
      "EXEC \"op://${5:NAME}\"",
      "$0"
    ],
    "description": "Common WHEN/SET/EXEC skeleton"
  },
  "LMTP rule (match incoming mail)": {
    "prefix": "lmtp",
    "body": [
      "WHEN @lmtp.rcpt.0 =~ /${1:support@}/ && @lmtp.msg.subject =~ /${2:.}/",
      "  SET @lmtp.res.code = 250",
      "  EMIT @ticket.subject = @lmtp.msg.subject,",
      "       @ticket.from   = @lmtp.mail.from,",
      "       @ticket.text   = @lmtp.msg.text",
      "$0"
    ],
    "description": "Match an inbound LMTP delivery (recipient + subject) and accept it"
  },
  "LOOP drain (cursor inside one op)": {
    "prefix": "loop",
    "body": [
      "EXEC \"${1:txco://kv/list}\"",
      "  WITH after = ${2:._page.next}, into = \"${3:_page}\"",
      "LOOP EVERY \"${4:2ms}\" UNTIL ${5:._page.next == \"\"} MAX ${6:50}",
      "$0"
    ],
    "description": "Re-run one op until a predicate holds, merging every pass into one payload"
  },
  "LOOP poll (until an endpoint says done)": {
    "prefix": "poll",
    "body": [
      "EXEC \"${1:https://api.example.com/jobs/42}\"",
      "  WITH method = \"GET\", timeout = \"${2:60s}\"",
      "LOOP EVERY \"${3:2s}\" UNTIL ${4:.status == \"done\"} MAX ${5:30}",
      "$0"
    ],
    "description": "Call an endpoint every few seconds until its response satisfies UNTIL"
  }
}
