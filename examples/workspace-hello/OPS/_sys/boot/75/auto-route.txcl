# _sys/boot scope 75 — path-gated auto-route hook.
#
# HTTP requests under /hello, /count, /loop and /exit route to the
# ws-hello stack; everything else falls through to scope 1000's 404.
# Single-stack local-dev workspace, so detect-tenant@0 has no hostname
# binding — scope 100's txco://route promotes this proposal.
#
# Production note: delete this file once you have real hostname
# bindings; path-prefix gating belongs in per-tenant routing, not the
# system bootstrap.
WHEN @route.to == ""
  && @src == "http"
  && @web.req.url.path =~ /^\/(hello|count|loop|exit)(\/.*)?$/
  EMIT @route.tenant = "default",
       @route.stack = "ws-hello",
       @route.to = "ws-hello/0",
       @route.ingress = "auto-route",
       @route.hostname_verified = true
