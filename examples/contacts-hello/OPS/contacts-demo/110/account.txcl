# POST /contacts/provision — step 2: create (or update) the account.
#
# An omitted/empty password GENERATES one and returns it exactly once in
# ._acct.password — only its argon2id hash is stored. A product that also
# runs the IMAP and calendar heads passes the password that account got
# (`password = ._imapacct.password`) so one credential opens Mail,
# Calendar and Contacts alike.
WHEN ._prov.username != ""
  EXEC "txco://contacts/account"
    WITH username = ._prov.username,
         password = ._prov.password,
         into = "_acct"
