# Success: all three ops answered. The generated password (if any) appears
# here once and nowhere else.
WHEN ._acct.username != "" && ._book.name != "" && ._put.uid != ""
  EMIT @web.res.body = &b64encode(&to_json(&object(
         "username", ._acct.username,
         "created", ._acct.created,
         "password", ._acct.password,
         "addressbook", &object("name", ._book.name, "path", ._book.path),
         "hello", &object("uid", ._put.uid, "etag", ._put.etag, "noop", ._put.noop),
         "carddav", &object("server", "pony.local.thanks.computer", "port", 8080, "tls", false, "path", "/carddav/")))),
       @web.res.status = 200,
       @web.res.headers.content-type.0 = "application/json",
       @halt = true
