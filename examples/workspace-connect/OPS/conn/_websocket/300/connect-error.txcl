# If the connect was refused (not a websocket run, unknown service, already
# bound, secrets, no provider) or nothing was listening, say so on the
# socket as a control frame the page can show — then the connection is
# just an idle socket the client can close or try again on. Its own scope
# (300): an op cannot read what another op in the same scope produced, so
# this must run after 200.
WHEN .msg.type == "connect" && .workspace.error.code != null
  EXEC "txco://websocket/reply"
    WITH text = &to_json(&object(
      "type", "error",
      "code", .workspace.error.code,
      "error", .workspace.error.message))
