# POST /setup — step 2: a standing grant. `service:demo` may ever be handed
# the secret DEMO_NEVER. Whether one request is allowed is decided when it is
# made; this is only the outer bound. Safe to run again.
WHEN ._cred.id != ""
  EXEC "txco://grant/put"
    WITH principal = "service:demo",
         kind      = "secret",
         name      = "DEMO_NEVER",
         into      = "_g_demo_never"
