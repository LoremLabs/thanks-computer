# A search error answers 500 with the structured code, so the probe — and a
# human — can see what broke. `search.error` sits at the envelope root, like
# `vector.error`: a rule can branch on it (`WHEN .search.error.code == …`).
# txco_search_disabled means this chassis runs with --search-store=none.
WHEN .search.error.code != ""
  EMIT @web.res.body = &b64encode(&to_json(&object(
         "error", .search.error.code,
         "message", .search.error.message))),
       @web.res.status = 500,
       @web.res.headers.content-type.0 = "application/json",
       @halt = true
