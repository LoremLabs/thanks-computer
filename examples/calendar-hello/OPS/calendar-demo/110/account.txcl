# POST /calendar/provision — step 2: create (or update) the account.
#
# The account holds no password. Its username signs in as a principal —
# here one per mailbox address, `mailbox:<address>`; a product would use
# its own (`pony:<slug>`, or a `user:` from txco://user/create) — and the
# password is a credential issued to that principal (step 3). Re-running
# this for an existing account changes nothing but what you pass.
WHEN ._prov.username != ""
  EXEC "txco://calendar/account"
    WITH username  = ._prov.username,
         principal = &concat("mailbox:", ._prov.username),
         into      = "_acct"
