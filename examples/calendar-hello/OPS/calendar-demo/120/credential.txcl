# POST /calendar/provision — step 3: the password, for a NEW account only.
#
# txco://credential/create generates it (it carries its credential's id,
# so a caller cannot choose one), returns it exactly once at
# ._cred.password, and stores only its argon2id hash. The chassis keeps
# it out of traces by itself. Its scope names the one head it opens; list
# more ("imap:*:*", "calendar:*:*", …) and one password opens them all.
#
# A re-provision finds the account (`created: false`) and issues nothing:
# rotating is credential/create, then credential/revoke with `except`.
WHEN ._acct.created == true
  EXEC "txco://credential/create"
    WITH principal      = ._acct.principal,
         scopes         = ["calendar:*:*"],
         label          = "calendar-hello provision",
         password_style = "words",
         into           = "_cred"
