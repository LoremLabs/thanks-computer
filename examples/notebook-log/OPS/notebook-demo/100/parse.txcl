# POST /log/append?nb=<name> — step 1: the body is JSON {"type": …,
# "data": …, "object_key"?: …}. The web inlet stamps the raw body base64
# at @web.req.body; decode + parse it into a private key for scope 110.
WHEN @src == "http" && @web.req.method == "POST" && @web.req.url.path == "/log/append"
  EMIT ._req = &try_json(&b64decode(@web.req.body))
