# POST /seed — step 2: provision (or update) the local account we watch.
#
# `desk@pony.local.thanks.computer` — the domain is dev-local and
# auto-verified once bound to this stack (see the README's hostname
# add), which is why txco://imap/account accepts it. The account holds no
# password: its username signs in as the principal `mailbox:desk`, and
# the password is a credential issued to it (110/seed_credential). This
# is the SAME username the source's `user` field names. Creating the
# account creates its INBOX.
WHEN ._seed_req == true
  EXEC "txco://imap/account"
    WITH username  = "desk@pony.local.thanks.computer",
         principal = "mailbox:desk",
         into      = "_acct"
