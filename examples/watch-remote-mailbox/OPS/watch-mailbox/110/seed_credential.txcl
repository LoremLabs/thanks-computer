# POST /seed — step 3a: the account's password, on the FIRST seed only.
#
# txco://credential/create generates it and answers once at
# ._cred.password (the chassis keeps it out of traces by itself); only
# its argon2id hash is stored. Its scope opens IMAP and nothing else.
# Store it as PONY_MAILBOX — see the README. To start over, revoke it
# (txco://credential/revoke) and issue another.
WHEN ._acct.created == true
  EXEC "txco://credential/create"
    WITH principal = ._acct.principal,
         scopes    = ["imap:*:*"],
         label     = "watch-remote-mailbox source",
         into      = "_cred"
