# POST /ipp/provision — step 3, in parallel: the password, for a NEW user
# only. txco://credential/create generates it, returns it exactly once at
# ._cred.password, and stores only its hash. `ipp:*:*` opens every printer
# the principal is granted; `ipp:research:print` would open that one alone.
# List more scopes ("imap:*:*", "drive:*:*") and the same password opens
# those heads too.
#
# A second provision for the same email finds the user (`created: false`)
# and issues nothing: the password was shown once. To replace it, issue a
# new credential and revoke the rest (docs/advanced/users.md, "Rotating").
WHEN ._user.created == true
  EXEC "txco://credential/create"
    WITH principal      = ._user.principal,
         scopes         = ["ipp:*:*"],
         label          = "ipp-hello provision",
         password_style = "words",
         into           = "_cred"
