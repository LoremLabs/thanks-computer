# A failed cred step answers 400 with the op's structured code: the principal already holds its limit of live credentials.
WHEN ._cred.error.code != ""
  EMIT @web.res.body = &b64encode(&to_json(&object(
         "step", "cred",
         "error", ._cred.error.code,
         "message", ._cred.error.message))),
       @web.res.status = 400,
       @web.res.headers.content-type.0 = "application/json",
       @halt = true
