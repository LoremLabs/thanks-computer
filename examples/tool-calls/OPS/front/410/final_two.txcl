# Both results back, each under its own call id, in the order the calls
# were made; the model answers with both facts.
WHEN exists ._res0.in_stock && exists ._res1.unit_price
  WITH messages = &array(&object("role", "user", "content", &concat("Can I order ", @web.req.url.query.qty.0, " of SKU ", @web.req.url.query.sku.0, ", and what would it cost?")),
                         ._turn.message,
                         &object("role", "tool", "tool_call_id", ._turn.tool_calls.0.id, "content", ._res0),
                         &object("role", "tool", "tool_call_id", ._turn.tool_calls.1.id, "content", ._res1)),
       tools    = ._tools.tools,
       provider = "openai",
       into     = "_final"
  EXEC "ai://chat"
