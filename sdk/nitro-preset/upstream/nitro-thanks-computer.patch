+export interface ThanksComputerOptions {
+  /**
+   * Answer every unknown page path with the app shell and status 200, for an
+   * app that routes in the browser. Detected for Nuxt `ssr: false`.
+   */
+  spa?: boolean;
+  /**
+   * The `public/` prefixes the platform caches for a year (e.g. `["assets/"]`),
+   * each a directory ending in "/". Derived from `publicAssets` entries with a
+   * one-year `maxAge` when unset (Nuxt: `_nuxt/`).
+   */
+  immutable?: string[];
+}
diff --git a/src/presets/thanks-computer/utils.ts b/src/presets/thanks-computer/utils.ts
new file mode 100644
index 0000000..c1795b8
--- /dev/null
+++ b/src/presets/thanks-computer/utils.ts
@@ -0,0 +1,149 @@
+import fsp from "node:fs/promises";
+import type { Nitro } from "nitro/types";
+import { join, relative } from "pathe";
+import { writeFile } from "../_utils/fs.ts";
+
+// Turns Nitro's output into a Web ABI build for Thanks, Computer:
+//
+//   txco-web/
+//     txco-web.json   the manifest
+//     public/         the site
+//     ops/            the rules that answer what no file does
+//     server/         the app as a Fetch handler (server builds only)
+//
+// The ops are plain txcl. A page navigation nothing else answered gets
+// 404.html with 404 (a prerendered site), or the app shell with 200 (an
+// `ssr: false` app). Every other HTTP request gets a plain 404.
+
+const PRODUCER = "nitro/thanks-computer";
+const SCOPE = 900_000;
+const YEAR = 31_536_000;
+
+type Mode = "static" | "spa" | "server";
+
+export async function writeWebABI(nitro: Nitro, { server }: { server: boolean }) {
+  const { dir, publicDir, serverDir } = nitro.options.output;
+  const opts = nitro.options.thanksComputer || {};
+
+  let entry: string | undefined;
+  if (server && !nitro.options.static) {
+    entry = relative(dir, join(serverDir, "index.mjs"));
+  } else {
+    // No server: anything in server/ is build-time output.
+    await fsp.rm(serverDir, { recursive: true, force: true });
+  }
+
+  const mode: Mode = entry ? "server" : isSpa(nitro) ? "spa" : "static";
+  const page =
+    mode === "spa"
+      ? ((await readPage(publicDir, "200.html")) ?? (await readPage(publicDir, "index.html")))
+      : await readPage(publicDir, "404.html");
+  if (mode === "spa" && !page) {
+    throw new Error("[thanks-computer] an `ssr: false` build needs its shell (200.html or index.html)");
+  }
+
+  await fsp.rm(join(dir, "ops"), { recursive: true, force: true });
+  for (const [path, text] of Object.entries(renderOps(mode, page))) {
+    await writeFile(join(dir, "ops", path), text);
+  }
+
+  const immutable =
+    opts.immutable ||
+    deriveImmutable(nitro.options.publicAssets, nitro.options.baseURL, nitro.options.framework?.name);
+  const manifest = {
+    abi: 1,
+    ...(entry && { server: { entry } }),
+    ...(immutable.length > 0 && { immutable }),
+    "x-producer": { name: PRODUCER },
+    "x-nitro": { preset: nitro.options.preset, mode },
+  };
+  await writeFile(join(dir, "txco-web.json"), JSON.stringify(manifest, null, 2) + "\n");
+
+  nitro.logger.success(
+    `Web ABI build (${mode}) written. Deploy it with \`txco apply\`${entry ? " (\`--static-only\` until the platform runs server/)" : ""}.`
+  );
+}
+
+function isSpa(nitro: Nitro): boolean {
+  const forced = nitro.options.thanksComputer?.spa;
+  if (typeof forced === "boolean") {
+    return forced;
+  }
+  // Nuxt prerenders /index.html as the app shell only for an `ssr: false` app.
+  if (nitro._prerenderedRoutes?.some((r) => r.route === "/index.html")) {
+    return true;
+  }
+  return nitro.options.routeRules?.["/**"]?.ssr === false;
+}
+
+async function readPage(publicDir: string, name: string) {
+  const html = await fsp.readFile(join(publicDir, name), "utf8").catch(() => undefined);
+  return html === undefined ? undefined : { name, html };
+}
+
+// A navigation: a GET or HEAD of a path whose last segment has no extension.
+const NAV_GUARD =
+  '@src == "http" && (@web.req.method == "GET" || @web.req.method == "HEAD")\n' +
+  "     && @web.req.url.path !~ /(?i)\\.[a-z0-9]+$/";
+
+const BUILTIN_404 =
+  '<!doctype html>\n<html lang="en"><head><meta charset="utf-8"><title>404 Not Found</title></head>' +
+  "<body><h1>404 Not Found</h1></body></html>\n";
+
+function renderOps(mode: Mode, page: { name: string; html: string } | undefined) {
+  const header = (what: string) => `# ${PRODUCER} — ${what} (generated; do not edit by hand).\n`;
+  const nav =
+    mode === "spa"
+      ? { file: "spa-fallback.txcl", what: "SPA fallback", status: 200 }
+      : { file: "page-404.txcl", what: "404 page", status: 404 };
+  return {
+    [`${SCOPE}/${nav.file}`]: `${header(nav.what)}WHEN ${NAV_GUARD}\n${emitPage(nav.status, page?.html ?? BUILTIN_404)}`,
+    // After the navigation op: ops in one scope run concurrently.
+    [`${SCOPE + 900}/not-found.txcl`]: `${header("not found")}WHEN @src == "http"
+  EMIT @web.res.status = 404,
+       @web.res.headers.content-type.0 = "text/plain; charset=utf-8",
+       @web.res.body = b64"404 not found\\n",
+       @halt = true
+`,
+  };
+}
+
+function emitPage(status: number, html: string) {
+  const escaped = html.replace(/\\/g, "\\\\").replace(/"/g, '\\"');
+  return `  EMIT @web.res.status = ${status},
+       @web.res.headers.content-type.0 = "text/html; charset=utf-8",
+       @web.res.headers.cache-control.0 = "no-cache",
+       @web.res.body = b64"${escaped}",
+       @halt = true
+`;
+}
+
+// The public/ prefixes whose files the framework caches for a year (Nuxt's
+// `_nuxt/`), minus any that hold a shorter-lived dir, except Nuxt's
+// cache-busted `<buildAssetsDir>/builds`.
+function deriveImmutable(
+  assets: { baseURL?: string; maxAge?: number }[],
+  appBaseURL: string,
+  framework?: string
+): string[] {
+  const trim = (u: string) => u.replace(/^\/+|\/+$/g, "");
+  const norm = (u?: string) => "/" + trim(u || "/");
+  const inside = (inner: string, outer: string) => inner === outer || inner.startsWith(outer + "/");
+  const dirs = assets.map((a) => ({ base: norm(a.baseURL), maxAge: a.maxAge || 0 }));
+  const kept = dirs
+    .filter((c) => c.maxAge >= YEAR && c.base !== "/")
+    .filter(
+      (c) =>
+        !dirs.some(
+          (o) =>
+            o.maxAge < YEAR &&
+            o.base !== "/" &&
+            inside(o.base, c.base) &&
+            !(framework === "nuxt" && o.base === c.base + "/builds")
+        )
+    )
+    .map((c) => c.base);
+  const outer = [...new Set(kept)].filter((b) => !kept.some((o) => o !== b && inside(b, o)));
+  const app = trim(appBaseURL);
+  return outer.map((b) => (app ? `${app}/` : "") + `${trim(b)}/`).sort();
+}
