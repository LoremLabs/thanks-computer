+import { promises as fsp } from "node:fs";
+import { resolve } from "pathe";
+import { describe, expect, it } from "vitest";
+import { setupTest, testNitro } from "../tests.ts";
+
+describe("nitro:preset:thanks-computer", async () => {
+  const ctx = await setupTest("thanks-computer");
+
+  testNitro(ctx, async () => {
+    const entryPath = resolve(ctx.outDir, "server/index.mjs");
+    const fetchHandler = await import(entryPath).then((m) => m.default.fetch);
+
+    return async ({ url, ...init }) => {
+      const res = await fetchHandler(new Request(`https://test.com${url}`, init), {
+        client: { ip: "203.0.113.7" },
+      });
+      return res;
+    };
+  });
+
+  it("writes a Web ABI build", async () => {
+    const manifest = JSON.parse(await fsp.readFile(resolve(ctx.outDir, "txco-web.json"), "utf8"));
+    expect(manifest.abi).toBe(1);
+    expect(manifest.server).toEqual({ entry: "server/index.mjs" });
+    const ops = await fsp.readdir(resolve(ctx.outDir, "ops/900000"));
+    expect(ops).toEqual(["page-404.txcl"]);
+    const catchAll = await fsp.readFile(resolve(ctx.outDir, "ops/900900/not-found.txcl"), "utf8");
+    expect(catchAll).toContain('WHEN @src == "http"');
+  });
+});
