+import "#nitro/virtual/polyfills";
+import { useNitroApp } from "nitro/app";
+import type { ServerRequest } from "srvx";
+
+const nitroApp = useNitroApp();
+
+// The Web ABI server shape: `fetch(request, ctx)`, ctx = { client: { ip } }.
+interface ThanksComputerContext {
+  client?: { ip?: string };
+}
+
+export default {
+  async fetch(req: ServerRequest, ctx?: ThanksComputerContext): Promise<Response> {
+    req.runtime ??= { name: "thanks-computer" };
+    req.ip ??= ctx?.client?.ip;
+    return nitroApp.fetch(req);
+  },
+};
