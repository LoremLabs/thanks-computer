+import { defineNitroPreset } from "../_utils/preset.ts";
+import type { Nitro } from "nitro/types";
+import { writeWebABI } from "./utils.ts";
+
+export type { ThanksComputerOptions as PresetOptions } from "./types.ts";
+
+// https://www.thanks.computer — a Web ABI build: public/, ops/, server/, txco-web.json
+
+const output = {
+  dir: "{{ rootDir }}/txco-web",
+  serverDir: "{{ output.dir }}/server",
+  publicDir: "{{ output.dir }}/public/{{ baseURL }}",
+};
+
+const thanksComputer = defineNitroPreset(
+  {
+    entry: "./thanks-computer/runtime/thanks-computer",
+    serveStatic: false, // The platform serves public/ before the app runs
+    noExternals: true, // server/ deploys without an install step
+    output,
+    commands: {
+      deploy: "txco apply",
+    },
+    hooks: {
+      async compiled(nitro: Nitro) {
+        await writeWebABI(nitro, { server: true });
+      },
+    },
+  },
+  {
+    name: "thanks-computer" as const,
+  }
+);
+
+const thanksComputerStatic = defineNitroPreset(
+  {
+    extends: "static",
+    output,
+    commands: {
+      deploy: "txco apply",
+    },
+    hooks: {
+      async compiled(nitro: Nitro) {
+        await writeWebABI(nitro, { server: false });
+      },
+    },
+  },
+  {
+    name: "thanks-computer-static" as const,
+    static: true,
+  }
+);
+
+export default [thanksComputer, thanksComputerStatic] as const;
