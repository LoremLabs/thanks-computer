{
  "name": "@txco/react-router",
  "version": "0.1.0",
  "description": "React Router preset for Thanks, Computer (txco): after `react-router build`, writes a Web ABI build — build/client as public/, a route-aware SPA fallback as ops/, and txco-web.json — for `txco apply` to install.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "react-router",
    "react-router-preset",
    "remix",
    "spa",
    "txco",
    "thanks-computer",
    "web-abi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoremLabs/thanks-computer.git",
    "directory": "sdk/react-router"
  },
  "homepage": "https://github.com/LoremLabs/thanks-computer/tree/master/sdk/react-router#readme",
  "bugs": "https://github.com/LoremLabs/thanks-computer/issues",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@txco/web-abi": "^0.2.0"
  },
  "peerDependencies": {
    "@react-router/dev": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
